# Ao copiar um valor para a Vercel, copie SÓ o valor: o dotenv corta o comentário
# inline, o campo da Vercel não corta e o comentário vira parte do valor.

# URL da aplicação (sem barra final)
# Produção: https://atelieexemplo.com.br
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — obtido em Settings > API no dashboard do projeto
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# Supabase service role — nunca expor no cliente
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Mercado Pago — obtido em mercadopago.com.br > Seu negócio > Credenciais
MERCADOPAGO_ACCESS_TOKEN=YOUR_MERCADOPAGO_ACCESS_TOKEN
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=YOUR_MERCADOPAGO_PUBLIC_KEY
MERCADOPAGO_WEBHOOK_SECRET=YOUR_MERCADOPAGO_WEBHOOK_SECRET

# Melhor Envio — obtido em melhorenvio.com.br
MELHOR_ENVIO_TOKEN=YOUR_MELHOR_ENVIO_TOKEN
MELHOR_ENVIO_BASE_URL=https://www.melhorenvio.com.br/api/v2
MELHOR_ENVIO_APP_NAME=AtelieExemplo
MELHOR_ENVIO_CONTACT_EMAIL=contato@atelieexemplo.com.br
MELHOR_ENVIO_WEBHOOK_SECRET=YOUR_MELHOR_ENVIO_WEBHOOK_SECRET

# Identidade e endereços da loja — MIGRADOS PARA O BANCO
#
# Endereço fiscal (o que sai na nota) e endereço de origem do frete (de onde o
# pacote sai) eram estas mesmas variáveis, e deixaram de coincidir. Hoje os dois
# são campos de store_settings, editados em /admin/config/fiscal e
# /admin/config/envio. As variáveis abaixo continuam sendo lidas SÓ como rede de
# segurança, enquanto o endereço de origem no painel não estiver completo — e
# nenhuma delas alimenta mais a NF-e. Podem ser removidas depois que
# /admin/diagnostico mostrar "Fonte do endereço: painel".
STORE_NOME=Atelie Exemplo
STORE_EMAIL=contato@atelieexemplo.com.br
STORE_TELEFONE=73999999999
# CNPJ sem pontuação (remetente no Melhor Envio)
STORE_DOCUMENTO=00000000000000
STORE_LOGRADOURO=Rua das Flores
STORE_NUMERO=123
STORE_COMPLEMENTO=
STORE_BAIRRO=Vila do Mar
STORE_CIDADE=Cidade Exemplo
STORE_ESTADO=BA
# CEP da loja em Vila do Mar
STORE_CEP_ORIGEM=01001000

# Focus NFe — obtido em app.focusnfe.com.br
FOCUS_NFE_TOKEN=YOUR_FOCUS_NFE_TOKEN
# segredo para validar callbacks
FOCUS_NFE_WEBHOOK_SECRET=YOUR_FOCUS_NFE_WEBHOOK_SECRET
# 'homologacao' ou 'producao' — trocar só no lançamento
FOCUS_NFE_AMBIENTE=homologacao
# Regime tributário migrou para /admin/config/fiscal — esta variável não é mais lida

# Dados fiscais do emitente (CNPJ, razão social, IE, CNAE, endereço fiscal)
# não são variáveis de ambiente: vivem em store_settings e são editados em
# /admin/config/fiscal.

# Correios (contrato próprio) — opcional. Sem USUARIO + CODIGO_ACESSO + CONTRATO
# a transportadora fica desligada e a cotação usa só o Melhor Envio.
CORREIOS_USUARIO=YOUR_CORREIOS_USUARIO
CORREIOS_CODIGO_ACESSO=YOUR_CORREIOS_CODIGO_ACESSO
CORREIOS_CONTRATO=YOUR_CORREIOS_CONTRATO
CORREIOS_CARTAO_POSTAGEM=YOUR_CORREIOS_CARTAO_POSTAGEM
# padrão: https://api.correios.com.br (use a URL de homologação para testes)
CORREIOS_BASE_URL=

# Resend — obtido em resend.com
# Domínio verificado: creation@atelieexemplo.com.br
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM=creation@atelieexemplo.com.br

# Fachada "site em construção" (middleware.ts) — bloqueia a vitrine pública
# enquanto o site ainda tem dados fake. Sem MAINTENANCE_MODE definida, fica
# ligada por padrão.
# 'false' desliga a fachada e libera a loja para todo mundo
MAINTENANCE_MODE=false
# token secreto: acessar ?preview=<token> em qualquer página libera a loja
# real só para quem tem o link, via cookie
MAINTENANCE_BYPASS_TOKEN=YOUR_MAINTENANCE_BYPASS_TOKEN

# Testes E2E (Playwright) — só para rodar npm run test:e2e
# URL do app em execução (padrão: http://localhost:3000)
E2E_BASE_URL=http://localhost:3000
# usuário admin de teste; sem ele os testes do painel são pulados
E2E_ADMIN_EMAIL=YOUR_E2E_ADMIN_EMAIL
E2E_ADMIN_PASSWORD=YOUR_E2E_ADMIN_PASSWORD
# opcional: sessão salva do Playwright, em vez de logar a cada teste
E2E_STORAGE_STATE=
